diff --git a/payload/Scripts/UETools/UEToolSuite.Update.psm1 b/payload/Scripts/UETools/UEToolSuite.Update.psm1
index 3b63f7d..34df644 100644
--- a/payload/Scripts/UETools/UEToolSuite.Update.psm1
+++ b/payload/Scripts/UETools/UEToolSuite.Update.psm1
@@ -7,7 +7,12 @@ function Invoke-UEToolSuiteUpdateCommand {
 
   $yes = $false
   foreach ($arg in @($CommandArguments)) {
-    switch (([string]$arg).Trim().ToLowerInvariant()) {
+    $normalizedArg = ([string]$arg).Trim().ToLowerInvariant()
+    if ([string]::IsNullOrWhiteSpace($normalizedArg)) {
+      continue
+    }
+
+    switch ($normalizedArg) {
       { $_ -in @('-y','--yes','-yes','/yes') } { $yes = $true; continue }
       default { throw "Unknown update option '$arg'. Usage: ue update [--yes]" }
     }
